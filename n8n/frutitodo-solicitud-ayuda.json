            },
            {
              "id": "2df4eab3-7b1a-4395-bf72-07cc3bc8d773",
              "name": "APP_INGEST_SECRET",
              "value": "REEMPLAZAR (mismo valor que GHL_INGEST_SECRET en Vercel)",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "46fb0a3b-1284-4263-8a9f-095e508c8715",
