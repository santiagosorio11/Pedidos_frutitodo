            }
          }
        }
      },
      "id": "09017395-1444-410f-b896-c32ab3537ee4",
      "name": "Leer últimos mensajes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// No dependemos de que el agente llene bien un campo: leemos lo que realmente se habló.\nconst input = $('Normalizar entrada').first().json;\nconst response = $input.first().json;\nconst raw = response.body?.messages;\n// GHL responde { messages: { messages: [...] } }; se aceptan también listas planas.\nconst messages = Array.isArray(raw) ? raw : Array.isArray(raw?.messages) ? raw.messages : [];\n\nconst turns = messages\n  .filter((message) => typeof message.body === 'string' && message.body.trim())\n  .sort((a, b) => new Date(a.dateAdded || 0) - new Date(b.dateAdded || 0))\n  .map((message) => `${message.direction === 'inbound' ? 'CLIENTE' : 'FRUTITODO'}: ${message.body.trim()}`);\n\nconst lastMessageId = messages\n  .slice()\n  .sort((a, b) => new Date(b.dateAdded || 0) - new Date(a.dateAdded || 0))[0]?.id || '';\n\nreturn [{\n  json: {\n    transcript: turns.join('\\n'),\n    turns: turns.length,\n    readStatus: response.statusCode,\n    // Idempotencia: el mismo último mensaje del mismo contacto es el mismo pedido.\n    idempotencySeed: `${input.contactId}|${input.action}|${lastMessageId || input.resumen}`,\n  },\n}];\n"
      },
      "id": "7d72e9e1-917f-499f-8c7c-0ed0ff7085f9",
      "name": "Armar transcripción",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').item.json.OPENAI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $('Config').item.json.OPENAI_MODEL,\n  messages: [\n    { role: 'system', content: \"Eres el extractor de pedidos de Frutitodo (supermercado de frutas, verduras, carnes y víveres en Colombia). Recibes los últimos mensajes de una conversación de WhatsApp entre el CLIENTE y FRUTITODO (el asistente) y, a veces, el resumen que el asistente guardó. Devuelve el pedido que el cliente confirmó, en JSON. Reglas: la conversación manda; si el resumen del asistente la contradice, gana lo que dijo el cliente. Si el asistente mostró un resumen final y el cliente lo confirmó, ese es el pedido; ignora borradores anteriores y aplica los cambios que el cliente pidió después. Copia los productos con su corte o preparación en el nombre ('Pechuga de pollo troceada'); cantidad numérica con punto decimal ('media libra' = 0.5 lb, 'una docena' = 12 unidad); unidad null si no es clara. No inventes productos, precios, direcciones ni datos. delivery.type es 'recogida' solo si el cliente recoge en tienda; en ese caso address es null. Si falta el nombre o el teléfono usa los datos del contacto que te doy. Si es un AJUSTE, devuelve el pedido completo ya ajustado, no solo el cambio. Si en los mensajes no hay un pedido con al menos un producto, responde ok=false con el motivo en error.\" },\n    { role: 'user', content: `Tipo: ${$('Normalizar entrada').item.json.action === 'amend' ? 'AJUSTE a un pedido existente' : 'PEDIDO NUEVO'}\\nContacto en GHL: ${$('Normalizar entrada').item.json.contactName || 'sin nombre'} / ${$('Normalizar entrada').item.json.contactPhone || 'sin teléfono'}\\n\\nConversación (del más antiguo al más reciente):\\n${$('Armar transcripción').item.json.transcript || '(sin mensajes)'}\\n\\nResumen guardado por el asistente (puede estar incompleto):\\n${$('Normalizar entrada').item.json.resumen || '(vacío)'}` }\n  ],\n  response_format: { type: 'json_schema', json_schema: { name: 'pedido_frutitodo', strict: true, schema: {\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"ok\", \"error\", \"customer\", \"delivery\", \"paymentMethod\", \"items\", \"notes\"], \"properties\": {\"ok\": {\"type\": \"boolean\", \"description\": \"false si el resumen no trae productos o no es un pedido\"}, \"error\": {\"type\": [\"string\", \"null\"], \"description\": \"Motivo cuando ok es false\"}, \"customer\": {\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"name\", \"phone\", \"document\"], \"properties\": {\"name\": {\"type\": \"string\"}, \"phone\": {\"type\": \"string\"}, \"document\": {\"type\": [\"string\", \"null\"], \"description\": \"Cédula sin puntos\"}}}, \"delivery\": {\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"type\", \"address\"], \"properties\": {\"type\": {\"type\": \"string\", \"enum\": [\"domicilio\", \"recogida\"]}, \"address\": {\"type\": [\"string\", \"null\"], \"description\": \"Dirección completa con barrio; null si recoge\"}}}, \"paymentMethod\": {\"type\": [\"string\", \"null\"], \"description\": \"Efectivo, Transferencia, Tarjeta (datáfono) u otro\"}, \"items\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"name\", \"quantity\", \"unit\"], \"properties\": {\"name\": {\"type\": \"string\", \"description\": \"Producto con su preparación: 'Pechuga de pollo troceada'\"}, \"quantity\": {\"type\": \"number\"}, \"unit\": {\"type\": [\"string\", \"null\"], \"description\": \"kg, lb, unidad, cubeta, paquete...\"}}}}, \"notes\": {\"type\": [\"string\", \"null\"], \"description\": \"Observaciones, sustituciones e indicaciones de entrega\"}}} } }\n}) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "4df5905e-9ef0-40b5-82db-f1ea03870e82",
      "name": "Extraer pedido (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $('Normalizar entrada').first().json;\nconst response = $input.first().json;\nconst conversation = $('Buscar conversación GHL').first().json;\nconst conversationId = conversation?.body?.conversations?.[0]?.id || null;\n\nlet extracted = null;\nlet problem = null;\nif (response.statusCode !== 200) {\n  problem = `OpenAI respondió ${response.statusCode}`;\n} else {\n  try {\n    extracted = JSON.parse(response.body?.choices?.[0]?.message?.content || 'null');\n  } catch (error) {\n    problem = 'La respuesta del modelo no es JSON válido';\n  }\n}\n\nconst transcript = $('Armar transcripción').first().json;\nif (!transcript.turns && !input.resumen) problem = `No se pudieron leer los mensajes de la conversación (GHL respondió ${transcript.readStatus})`;\nif (!problem && extracted && !extracted.ok) problem = extracted.error || 'La conversación no contiene un pedido';\nconst items = (extracted?.items || [])\n  .map((item) => ({\n    name: String(item.name || '').trim(),\n    quantity: Number(item.quantity),\n    ...(item.unit ? { unit: String(item.unit).trim() } : {}),\n  }))\n  .filter((item) => item.name && item.quantity > 0);\nif (!problem && !items.length) problem = 'El pedido no tiene productos con cantidad';\n\nconst name = (extracted?.customer?.name || input.contactName || '').trim();\nconst phone = (extracted?.customer?.phone || input.contactPhone || '').trim();\nif (!problem && !name) problem = 'Falta el nombre del cliente';\nif (!problem && phone.length < 3) problem = 'Falta el teléfono del cliente';\nconst delivery = extracted?.delivery?.type === 'recogida'\n  ? { type: 'recogida' }\n  : { type: 'domicilio', address: (extracted?.delivery?.address || '').trim() };\nif (!problem && delivery.type === 'domicilio' && !delivery.address) problem = 'Falta la dirección del domicilio';\n\n// Resumen legible que se guarda de vuelta en GHL (campo pedido_resumen).\nconst summaryText = [\n  `Cliente: ${name}${extracted?.customer?.document ? ` | Cédula: ${extracted.customer.document}` : ''} | Tel: ${phone}`,\n  delivery.type === 'recogida' ? 'Entrega: Recoge en tienda' : `Entrega: Domicilio – ${delivery.address}`,\n  extracted?.paymentMethod ? `Pago: ${extracted.paymentMethod}` : null,\n  'Productos:',\n  ...items.map((item) => `- ${item.quantity}${item.unit ? ` ${item.unit}` : ''} ${item.name}`),\n  extracted?.notes ? `Observaciones: ${extracted.notes}` : null,\n].filter(Boolean).join('\\n');\n\nreturn [{\n  json: {\n    valid: !problem,\n    problem,\n    action: input.action,\n    conversationId,\n    idempotencySeed: transcript.idempotencySeed,\n    summaryText,\n    payload: {\n      locationId: input.locationId,\n      contactId: input.contactId,\n      conversationId: conversationId || undefined,\n      customer: { name, phone, document: extracted?.customer?.document || undefined },\n      delivery,\n      paymentMethod: extracted?.paymentMethod || undefined,\n      items,\n      notes: extracted?.notes || undefined,\n    },\n  },\n}];\n"
      },
