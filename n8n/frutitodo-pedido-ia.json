      "id": "dc58686f-0615-4987-92f3-5023d965a2b1",
      "name": "401 No autorizado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "// Body enviado por el Custom Webhook de GHL (ver docs/ghl-setup.md).\nconst body = $('Webhook').first().json.body || {};\nconst clean = (value) => (typeof value === 'string' ? value.trim() : '');\nconst action = clean(body.action).toLowerCase() === 'amend' ? 'amend' : 'create';\nreturn [{\n  json: {\n    action,\n    locationId: clean(body.locationId),\n    contactId: clean(body.contactId),\n    contactName: clean(body.contactName),\n    contactPhone: clean(body.contactPhone),\n    // Opcional: la fuente principal es la conversación; el resumen del agente solo ayuda.\n    resumen: clean(body.resumen),\n  },\n}];\n"
      },
      "id": "1fb1fa33-0b83-4bf2-9cce-3b337eea2286",
      "name": "Normalizar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://services.leadconnectorhq.com/conversations/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
