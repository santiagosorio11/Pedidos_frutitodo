      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst status = response.statusCode;\nconst body = response.body || {};\nconst ok = status >= 200 && status < 300 && Boolean(body.order?.number);\n// Un ajuste conserva el número: es el mismo pedido, no uno nuevo.\nconst adjusted = ok && body.amended !== undefined;\nreturn [{\n  json: {\n    ok,\n    status,\n    adjusted,\n    orderNumber: body.order?.number || null,\n    duplicate: Boolean(body.duplicate),\n    error: ok ? null : (body.message || `La app respondió ${status}`),\n  },\n}];\n"
