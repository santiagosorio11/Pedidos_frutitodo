        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => {\n  const cfg = $('Config').item.json;\n  const p = $('Validar extracción').item.json.payload;\n  const r = $('Resultado').item.json;\n  const fields = [\n    [cfg.CF_ULTIMO_PEDIDO_NUMERO, r.orderNumber],\n    [cfg.CF_ULTIMO_PEDIDO_ESTADO, 'nuevo'],\n    [cfg.CF_PEDIDO_RESUMEN, $('Validar extracción').item.json.summaryText],\n    [cfg.CF_CEDULA, p.customer.document],\n    [cfg.CF_METODO_PAGO, p.paymentMethod],\n    [cfg.CF_DIRECCION, p.delivery.type === 'domicilio' ? p.delivery.address : null],\n  ].filter(([key, value]) => key && value);\n  const body = { customFields: fields.map(([key, value]) => ({ key, field_value: value })) };\n  if (p.delivery.type === 'domicilio') body.address1 = p.delivery.address;\n  return JSON.stringify(body);\n})() }}",
