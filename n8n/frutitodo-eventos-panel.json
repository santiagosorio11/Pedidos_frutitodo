    {
      "parameters": {
        "jsCode": "// Eventos que envía la app (N8N_DISPATCH_WEBHOOK_URL): order.printed y order.dispatched.\n// La cotización NO pasa por aquí: el panel la envía directo con la API de GHL.\nconst cfg = $('Config').first().json;\nconst event = $('Webhook').first().json.body || {};\nconst order = event.order || {};\nconst firstName = (order.customerName || '').split(' ')[0] || '';\n\nconst fields = [];\nlet message = null;\n\nif (event.event === 'order.printed') {\n  fields.push([cfg.CF_ULTIMO_PEDIDO_ESTADO, 'en_preparacion']);\n}\n\nif (event.event === 'order.dispatched') {\n  fields.push([cfg.CF_ULTIMO_PEDIDO_ESTADO, 'despachado']);\n  // Texto provisional: Frutitodo debe enviar el mensaje definitivo.\n  message = order.deliveryType === 'recogida'\n    ? `Hola ${firstName} 👋 Tu pedido ${order.orderNumber} ya está listo para recoger en tienda.`\n    : `Hola ${firstName} 👋 Tu pedido ${order.orderNumber} ya va en camino 🛵. ¡Gracias por comprar en Frutitodo!`;\n}\n\nreturn [{\n  json: {\n    event: event.event,\n    contactId: event.ghlContactId,\n    customFields: fields.filter(([key, value]) => key && value).map(([key, value]) => ({ key, field_value: value })),\n    message,\n  },\n}];\n"
      },
